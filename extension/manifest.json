{
  "manifest_version": 3,
  "name": "OpenAI Proxy via Browser",
  "version": "0.1.0",
  "description": "把本地 AI 网页（任意站点，自行配置选择器）包装成 OpenAI 兼容的本地 API 网关。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenAI Proxy via Browser"
  }
}
